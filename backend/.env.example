# Server
PORT=3001
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=edu_isr
DB_USER=root
DB_PASSWORD=root

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# CORS
FRONTEND_URL=http://localhost:5173

# Rate limits per client IP (0 disables a limit)
RATE_LIMIT_REGISTER_PER_HOUR=50
RATE_LIMIT_LOGIN_PER_15MIN=100
RATE_LIMIT_LOGIN_FAILED_PER_15MIN=10
