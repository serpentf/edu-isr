# Environment for the backend service. Copy to /etc/edu-isr/backend.env (chmod 600)
# and fill in. Never commit real values.
NODE_ENV=production

# Listen on the internal address only: the reverse proxy connects here
HOST=192.0.2.10
PORT=3001

# One reverse proxy (nginx) in front of the app
TRUST_PROXY_HOPS=1

# Built frontend served by the backend itself
STATIC_DIR=/opt/edu-isr/frontend/dist
FRONTEND_URL=https://edu.example.com

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=edu_isr
DB_USER=edu_isr
# openssl rand -hex 24
DB_PASSWORD=

# openssl rand -hex 32 — the app refuses to start without a strong secret
JWT_SECRET=
JWT_EXPIRES_IN=7d
